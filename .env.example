# App connection: non-superuser role that is subject to Row-Level Security.
# Create it once with: psql -h localhost -d angelic_booking -f packages/db/sql/roles.sql
DATABASE_URL=postgres://angelic_app:angelic_app_dev@localhost:5432/angelic_booking
# Admin connection used ONLY for migrations / drizzle studio.
DATABASE_ADMIN_URL=postgres://localhost:5432/angelic_booking
# Hosted Postgres (Render, Neon, ...) reached over the internet: append ?sslmode=require to both URLs.

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-32-plus-char-random-string
BETTER_AUTH_URL=http://localhost:3000
# Optional: "Continue with Google". Create an OAuth 2.0 Web client in Google Cloud Console
# (APIs & Services → Credentials) and add <BETTER_AUTH_URL>/api/auth/callback/google as an
# authorised redirect URI. Leave blank to hide the button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (the PLATFORM's account). Each business connects its own account via Stripe Connect.
# Secret key: Developers → API keys. Webhook secret: Developers → Webhooks → add a CONNECT
# endpoint for <NEXT_PUBLIC_APP_URL>/api/stripe/webhook (account.updated, payment_intent.succeeded,
# payment_intent.payment_failed, charge.refunded). Leave the "..." placeholders to run without Stripe.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Prices (base plan, text number, texts, platform fee, trial) are NOT environment variables: they live in the database price book,
# edited on the admin app's Pricing page. Until one is saved everything is $0.

# Local test account created during the first browser walkthrough (dev DB only).
# DEV_TEST_EMAIL=owner@example.com
# DEV_TEST_PASSWORD=angelic-dev-pass-2026
# DEV_TEST_BUSINESS_SLUG=angelic-salon

# Client messaging (optional; without these, messages are logged as "skipped").
# Resend: https://resend.com — EMAIL_FROM must be on a verified domain.
RESEND_API_KEY=re_...
EMAIL_FROM="Angelic Booking <bookings@yourdomain.com>"
# Twilio (the PLATFORM's account). Each business buys its own toll-free number from
# inside the app (Settings → Text messaging) and submits carrier verification; texts go
# out from that number once verified. TWILIO_FROM / TWILIO_MESSAGING_SERVICE_SID are an
# OPTIONAL platform-wide fallback sender for businesses without a verified number.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+18005550100
# TWILIO_MESSAGING_SERVICE_SID=MG...
# Platform billing (Stripe Billing on the platform account; products/prices/meter are created on
# first use from the price book amounts, keyed by amount). Businesses add a
# card at Settings → Billing (Stripe Checkout); the text number is a subscription item and each
# text sent is a meter event. Needs an ACCOUNT webhook (not Connect) for
# <NEXT_PUBLIC_APP_URL>/api/stripe/billing: checkout.session.completed, customer.subscription.*,
# invoice.paid, invoice.payment_failed.
STRIPE_BILLING_WEBHOOK_SECRET=whsec_...

# Cloudflare R2 object storage for uploaded pictures and client files. Leave all unset to keep storing
# files in Postgres (fine for local development). Create the buckets and the CDN domain with
# apps/web/scripts/provision-r2.ts; the access key and secret come from R2 > Manage API tokens.
# R2_PUBLIC_BASE_URL is where the public bucket is served from (a custom domain on your Cloudflare zone).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=

# Shared secret for the reminder job. Call POST /api/jobs/notifications every few
# minutes with "Authorization: Bearer $JOBS_SECRET" (Vercel Cron, DO Functions, or cron+curl).
JOBS_SECRET=change-me

# Error reporting (optional). Unhandled request errors are POSTed here as JSON
# (Slack/Discord incoming webhook or your own endpoint). See docs-ops.md for Sentry.
ERROR_WEBHOOK_URL=

# Shown on Help, Privacy and Terms pages as the contact address (optional).
# SUPPORT_EMAIL=

# Demo tenants (apps/web/scripts/seed-demo.ts). Locally the default below is fine. A hosted demo sets its own secret here and
# DEMO_ALLOW_REMOTE=1 (see docs-ops.md, Demo tenant). Demo businesses (slug demo-*) never email or text anyone.
DEMO_PASSWORD=demo-salon-2026
#DEMO_ALLOW_REMOTE=1
# Optional, local only: a separate Stripe SANDBOX account (test keys) for the demo salon, so card checkout, the card reader and online deposits can be
# tried on it. It is not connected to the platform, so requests for it are sent with its own key (apps/web/src/lib/stripe-demo.ts). Ignored in production.
# `pnpm demo:refresh` then links demo-salon to it (scripts/link-demo-stripe.ts).
# DEMO_ACCOUNT_STRIPE_SECRET_TEST_KEY=sk_test_...
# DEMO_ACCOUNT_STRIPE_PUBLISHABLE_TEST_KEY=pk_test_...

# Platform admin app (apps/admin). Own service, own domain (e.g. admin.angelicbooking.com).
# Create the read-only, RLS-bypassing role once: psql … -f packages/db/sql/admin-role.sql
ADMIN_DATABASE_URL=postgres://angelic_admin:angelic_admin_dev@localhost:5432/angelic_booking
# Admin accounts (email + hashed password) live in the admin_users table, not here. Make the first one with:
#   pnpm --filter @angelic/admin create-admin you@example.com
# then add more from the app (Admins). ADMIN_EMAIL / ADMIN_PASSWORD_HASH are no longer read once an account exists.
ADMIN_SESSION_SECRET=change-me-to-a-32-plus-char-random-string
# The admin app's own address, used in password-reset links and as the Google redirect (https://admin.angelicbooking.com in production).
# ADMIN_BASE_URL=http://localhost:3002
# Password-reset emails use RESEND_API_KEY / EMAIL_FROM (above); "Continue with Google" uses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (above)
# and the redirect URI <ADMIN_BASE_URL>/auth/google/callback must be added to the Google OAuth client. Only enabled admins (by their
# verified email) may sign in with Google.
# Optional but recommended: require an authenticator code at login. Generate with: pnpm --filter @angelic/admin totp-secret
# ADMIN_TOTP_SECRET=
# Optional: lets the admin app show what Stripe actually bills each business. Use a RESTRICTED key (read-only: Subscriptions).
# STRIPE_SECRET_KEY=rk_live_...
