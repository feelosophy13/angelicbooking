# App connection: non-superuser role that is subject to Row-Level Security.
# Create it once with: psql -h localhost -d angelic_booking -f packages/db/sql/roles.sql
DATABASE_URL=postgres://angelic_app:angelic_app_dev@localhost:5432/angelic_booking
# Admin connection used ONLY for migrations / drizzle studio.
DATABASE_ADMIN_URL=postgres://localhost:5432/angelic_booking
# Hosted Postgres (Render, Neon, ...) reached over the internet: append ?sslmode=require to both URLs.

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-32-plus-char-random-string
BETTER_AUTH_URL=http://localhost:3000
# Optional: "Continue with Google". Create an OAuth 2.0 Web client in Google Cloud Console
# (APIs & Services → Credentials) and add <BETTER_AUTH_URL>/api/auth/callback/google as an
# authorised redirect URI. Leave blank to hide the button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (the PLATFORM's account). Each business connects its own account via Stripe Connect.
# Secret key: Developers → API keys. Webhook secret: Developers → Webhooks → add a CONNECT
# endpoint for <NEXT_PUBLIC_APP_URL>/api/stripe/webhook (account.updated, payment_intent.succeeded,
# payment_intent.payment_failed, charge.refunded). Leave the "..." placeholders to run without Stripe.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional per-transaction platform fee on card payments, in basis points (100 = 1%). 0 = none.
PLATFORM_FEE_BPS=0

# Local test account created during the first browser walkthrough (dev DB only).
# DEV_TEST_EMAIL=owner@example.com
# DEV_TEST_PASSWORD=angelic-dev-pass-2026
# DEV_TEST_BUSINESS_SLUG=angelic-salon

# Client messaging (optional; without these, messages are logged as "skipped").
# Resend: https://resend.com — EMAIL_FROM must be on a verified domain.
RESEND_API_KEY=re_...
EMAIL_FROM="Angelic Booking <bookings@yourdomain.com>"
# Twilio: either a phone number (TWILIO_FROM) or a Messaging Service SID.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM=+15550100000
# TWILIO_MESSAGING_SERVICE_SID=MG...

# Shared secret for the reminder job. Call POST /api/jobs/notifications every few
# minutes with "Authorization: Bearer $JOBS_SECRET" (Vercel Cron, DO Functions, or cron+curl).
JOBS_SECRET=change-me

# Error reporting (optional). Unhandled request errors are POSTed here as JSON
# (Slack/Discord incoming webhook or your own endpoint). See docs-ops.md for Sentry.
ERROR_WEBHOOK_URL=

# Shown on Help, Privacy and Terms pages as the contact address (optional).
# SUPPORT_EMAIL=
